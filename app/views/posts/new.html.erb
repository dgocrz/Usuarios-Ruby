<div class="card mx-auto" style="max-width: 600px;">
  <div class="card-body">
    <h3 class="card-title mb-4">Nuevo Post</h3>

    <%= form_with model: @post do |f| %>
      <div class="mb-3">
        <%= f.label :title, class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :content, class: "form-label" %>
        <%= f.text_area :content, rows: 5, class: "form-control" %>
      </div>

      <%= f.submit "Publicar", class: "btn btn-success w-100" %>
    <% end %>

    <div class="mt-3 text-center">
      <%= link_to "Volver al Dashboard", dashboard_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>
